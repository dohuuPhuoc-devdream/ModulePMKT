<%@ Page Language="C#" MasterPageFile="~/Site.Master" CodeBehind="ChangePassword.aspx.cs" Inherits="ReportingModule.Web.ChangePasswordPage" ViewStateEncryptionMode="Always" %>
<asp:Content ID="Main" ContentPlaceHolderID="WorkspaceContent" runat="server"><section class="admin-surface"><h1>Đổi mật khẩu</h1><asp:Label ID="Message" runat="server" CssClass="catalog-message" role="status" /><div class="catalog-fields"><div class="catalog-field"><asp:Label runat="server" AssociatedControlID="Current" Text="Mật khẩu hiện tại" /><asp:TextBox ID="Current" runat="server" TextMode="Password" MaxLength="256" autocomplete="current-password" /></div><div class="catalog-field"><asp:Label runat="server" AssociatedControlID="NewPassword" Text="Mật khẩu mới" /><asp:TextBox ID="NewPassword" runat="server" TextMode="Password" MaxLength="256" autocomplete="new-password" /></div><div class="catalog-field"><asp:Label runat="server" AssociatedControlID="Confirm" Text="Nhập lại mật khẩu mới" /><asp:TextBox ID="Confirm" runat="server" TextMode="Password" MaxLength="256" autocomplete="new-password" /></div></div><p class="muted">Mật khẩu mới cần ít nhất 12 ký tự.</p><asp:Button ID="Save" runat="server" Text="Đổi mật khẩu" CssClass="catalog-button" OnClick="Save_Click" /></section></asp:Content>
