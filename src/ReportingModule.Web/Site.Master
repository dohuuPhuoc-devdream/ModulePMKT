<%@ Master Language="C#" CodeBehind="Site.Master.cs" Inherits="ReportingModule.Web.SiteShell" %>
<!DOCTYPE html>
<html lang="vi">
<head runat="server">
 <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
 <title>Ứng dụng kế toán</title>
 <link href="Content/site.css" rel="stylesheet" />
</head>
<body>
 <a class="skip-link" href="#workspace">Đến nội dung</a>
 <form id="MainForm" runat="server">
  <div class="shell-top">
  <header class="app-header"><a class="app-name" href="Default.aspx"><%: ReportingModule.Web.AppIdentity.ProductName %> <span>/ Nghiệp vụ &amp; báo cáo</span></a><asp:PlaceHolder ID="IdentityPanel" runat="server" /></header>
  <asp:HiddenField ID="CsrfToken" runat="server" />
   <nav class="main-navigation" aria-label="Phân hệ nghiệp vụ"><ul class="module-list"><%= RenderNavigation() %></ul></nav>
  </div>
  <main id="workspace" class="workspace" tabindex="-1"><asp:ContentPlaceHolder ID="WorkspaceContent" runat="server" /></main>
 </form>
 <script src="Scripts/site.js"></script>
</body>
</html>
